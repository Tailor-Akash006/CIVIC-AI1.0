// CIVICMIND Database Schema
// Optimized for PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  ADMIN
  AUTHORITY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(CITIZEN)
  phone        String?
  department   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relationships
  complaintsReported Complaint[]        @relation("CitizenComplaints")
  complaintsAssigned Complaint[]        @relation("AssignedAuthority")
  historyEntries     ComplaintHistory[]

  @@map("users")
}

model Complaint {
  id              String          @id @default(uuid())
  trackingId      String          @unique // e.g. CIV-2026-8941
  title           String
  description     String          @db.Text
  category        String          // roads_potholes, water_sewage, street_lighting, etc.
  aiCategory      String?
  aiSummary       String?         @db.Text
  latitude        Float
  longitude       Float
  address         String?
  ward            String?
  imageUrl        String?
  priority        Priority        @default(MEDIUM)
  priorityScore   Int             @default(50) // 0 - 100
  priorityReason  String?         @db.Text    // Plain-language AI explanation
  status          ComplaintStatus @default(SUBMITTED)
  
  // Citizen contact details (supports anonymous submissions)
  isAnonymous     Boolean         @default(false)
  reporterName    String?
  reporterEmail   String?
  reporterPhone   String?

  // Relations & Assignments
  createdBy       String?
  createdByUser   User?           @relation("CitizenComplaints", fields: [createdBy], references: [id], onDelete: SetNull)

  assignedTo      String?
  assignedUser    User?           @relation("AssignedAuthority", fields: [assignedTo], references: [id], onDelete: SetNull)

  assignedDept    String?

  // Duplicate clustering self-relation
  duplicateOf     String?
  parentComplaint Complaint?      @relation("ComplaintDuplicates", fields: [duplicateOf], references: [id], onDelete: SetNull)
  duplicates      Complaint[]     @relation("ComplaintDuplicates")
  duplicateScore  Int?            // Similarity score (0-100)

  // Status Audit Trail
  history         ComplaintHistory[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([trackingId])
  @@index([latitude, longitude])
  @@index([ward])
  @@map("complaints")
}

model ComplaintHistory {
  id             String           @id @default(uuid())
  complaintId    String
  complaint      Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  previousStatus ComplaintStatus?
  newStatus      ComplaintStatus
  changedBy      String           // User name or 'AI Triage Engine' or 'System'
  changedById    String?
  user           User?            @relation(fields: [changedById], references: [id], onDelete: SetNull)
  actorRole      String?          // citizen, dispatcher, field_crew, admin, ai_system
  remarks        String?          @db.Text
  createdAt      DateTime         @default(now())

  @@index([complaintId])
  @@map("complaint_history")
}

model Authority {
  id         String   @id @default(uuid())
  name       String
  department String
  email      String   @unique
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("authorities")
}
